    <string name="feature_reliability_step_notifications">Notifications</string>
    <string name="feature_reliability_step_notifications_body">So the adhan can show the prayer\'s name and a Stop button.</string>
    <string name="feature_reliability_step_exact">Exact alarms</string>
    <string name="feature_reliability_step_exact_body">So the adhan starts on time, not minutes late.</string>
    <string name="feature_reliability_step_battery">Battery: unrestricted</string>
    <string name="feature_reliability_step_battery_body">Otherwise the battery saver can hold the adhan back. If your phone asks, choose “Allow background activity” or “Unrestricted”.</string>
    <string name="feature_reliability_step_background">Auto-start and background activity</string>
    <string name="feature_reliability_step_background_body">Many phones add their own limits on top of Android, called auto-start, app launch or background activity. If yours has one, allow it for Deen. If you can\'t find it, your phone doesn\'t need it: just tick the box.</string>
    <string name="feature_reliability_step_recents">Lock Deen in recent apps</string>
    <string name="feature_reliability_step_recents_body">On some phones, clearing recent apps also stops their alarms. Open recent apps, long-press Deen\'s card (or swipe it down) and tap Lock if your phone offers it.</string>

    <string name="feature_reliability_test_title">Test the adhan</string>
    <string name="feature_reliability_test_body">Tap the button, lock your phone and wait one minute. If you hear the adhan, everything works.</string>
    <string name="feature_reliability_test_button">Test adhan in 1 minute</string>
    <string name="feature_reliability_test_waiting">Lock your phone now · %1$s</string>

