    <string name="feature_settings_src_quran">Quran text</string>
    <string name="feature_settings_src_quran_body">Tanzil Project, Uthmani text 1.1, used verbatim under CC BY 3.0. Font: Amiri Quran.</string>
    <string name="feature_settings_src_hadith">Hadith collections</string>
    <string name="feature_settings_src_hadith_body">Arabic text, numbering and gradings of the six books, the Muwatta and the Forty Qudsi from hadith-api (Unlicense). The texts are classical and in the public domain.</string>
    <string name="feature_settings_src_adhkar">Adhkar</string>
    <string name="feature_settings_src_adhkar_body">Morning and evening adhkar in the wording of Hisn al-Muslim, from Seen-Arabic (MIT). Other adhkar taken from the cited hadith and checked against them.</string>
    <string name="feature_settings_src_english">English translations</string>
    <string name="feature_settings_src_english_body">The English of the adhkar, an-Nawawi\'s Forty and the facts about the Prophet ﷺ was written for Deen and is awaiting review by a qualified reviewer.</string>
    <string name="feature_settings_src_adhan">Adhan recordings</string>
    <string name="feature_settings_src_adhan_body">Wikimedia Commons: “Beautiful adhan” (CC0), “Azan” by Andrewler (CC BY-SA 4.0), “The Adhan – Aaqib Azeez” uploaded by Atcovi (CC BY-SA 4.0, loudness adjusted).</string>
    <string name="feature_settings_src_tafsir">Tafsir and meaning</string>
    <string name="feature_settings_src_tafsir_body">Tafsir al-Jalalayn is on your phone. Ibn Kathir, al-Baghawi and al-Qurtubi download from the tafsir_api dataset (MIT) the first time you open a surah. All are classical texts. English meaning: M. Pickthall (1930, public domain).</string>
    <string name="feature_settings_src_recitation">Recitations</string>
    <string name="feature_settings_src_recitation_body">Recitations stream from EveryAyah.com and stay on your phone after the first play. Word timings for the highlighting: quran-align by Collin Fair (CC BY 4.0).</string>
    <string name="feature_settings_src_times">Prayer times</string>
    <string name="feature_settings_src_times_body">Calculated on your phone with adhan-kotlin by Batoul Apps (MIT).</string>
    <string name="feature_settings_src_cities">Cities</string>
    <string name="feature_settings_src_cities_body">GeoNames (CC BY 4.0).</string>
    <string name="feature_settings_src_fonts">Fonts and icons</string>
    <string name="feature_settings_src_fonts_body">Readex Pro, Amiri and Amiri Quran (SIL Open Font License). Material Symbols (Apache 2.0).</string>
    <string name="feature_settings_src_app">Deen</string>
    <string name="feature_settings_src_app_body">Free software under GPL-3.0-or-later. No ads, no tracking.</string>
