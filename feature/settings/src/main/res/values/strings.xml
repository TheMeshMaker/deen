    <string name="feature_settings_source_code_body">GPL-3.0 on GitHub</string>
    <string name="feature_settings_after_adhan">Remind me to pray after the adhan</string>
    <string name="feature_settings_after_adhan_body">Optional. A gentle nudge a few minutes after each adhan; choose the time for each prayer.</string>
    <string name="feature_settings_privacy">Privacy</string>
    <string name="feature_settings_privacy_body">No ads, no tracking, no account. Everything works offline except Quran recitations and the longer tafsirs, which download when you open them. Nothing about you is sent.</string>
