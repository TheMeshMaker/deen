    "feature_settings_src_adhan_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikimedia Commons: “Beautiful adhan” (CC0), “Azan” by Andrewler (CC BY-SA 4.0), “The Adhan – Aaqib Azeez” uploaded by Atcovi (CC BY-SA 4.0, loudness adjusted)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من ويكيميديا كومنز: «Beautiful adhan» (CC0)، و«Azan» من Andrewler (CC BY-SA 4.0)، و«The Adhan – Aaqib Azeez» من رفع Atcovi (CC BY-SA 4.0، مع ضبط مستوى الصوت)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Wikimedia Commons: “Beautiful adhan” (CC0)، Andrewler کی “Azan” (CC BY-SA 4.0)، Atcovi کی اپ لوڈ کردہ “The Adhan – Aaqib Azeez” (CC BY-SA 4.0، آواز برابر کی گئی)۔"
          }
        },
        "id": {
