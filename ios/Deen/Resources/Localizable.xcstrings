    "feature_adhkar_reset_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear today's counts for these adhkar?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسح عدّ هذه الأذكار لليوم؟"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان اذکار کی آج کی گنتی صاف کریں؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus hitungan hari ini untuk zikir ini?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu zikirlerin bugünkü sayımı silinsin mi?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই জিকিরগুলোর আজকের গণনা মুছবেন?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer les comptes d’aujourd’hui pour ces adhkar ?"
          }
        }
      }
    },
    "feature_adhkar_review_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arabic follows the cited hadith and the Quran text. The English is Deen's own and awaits review."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص العربي مطابق للأحاديث المذكورة ولنص المصحف، والترجمة الإنجليزية من إعداد دِين وبانتظار المراجعة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عربی متن مذکورہ احادیث اور قرآن کے مطابق ہے۔ انگریزی ترجمہ دین کا اپنا ہے اور نظرِ ثانی کا منتظر ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks Arab mengikuti hadis yang disebut dan teks Al-Qur'an. Terjemahan Inggris dibuat oleh Deen dan sedang menunggu tinjauan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arapça metin, adı geçen hadislere ve Kur'an metnine uygundur. İngilizce çeviri Deen'e aittir ve incelenmeyi bekliyor."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরবি পাঠ উল্লিখিত হাদিস ও কুরআনের পাঠ অনুযায়ী। ইংরেজি অনুবাদ Deen-এর নিজস্ব এবং পর্যালোচনার অপেক্ষায়।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arabe suit les hadiths cités et le texte du Coran. L’anglais est propre à Deen et attend une relecture."
          }
        }
      }
    },
