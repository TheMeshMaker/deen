    "feature_onboarding_location_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times depend on your location. It stays on your phone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعتمد مواقيت الصلاة على موقعك، ويبقى موقعك على هاتفك فقط."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز کے اوقات آپ کے مقام پر منحصر ہیں۔ یہ آپ کے فون ہی میں رہتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu salat bergantung pada lokasi Anda. Lokasi tetap tersimpan di ponsel Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz vakitleri konumunuza bağlıdır. Konumunuz telefonunuzda kalır."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজের সময় আপনার অবস্থানের উপর নির্ভর করে। এটি আপনার ফোনেই থাকে।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures de prière dépendent de votre position. Elle reste sur votre téléphone."
          }
        }
      }
    },
    "feature_onboarding_location_detecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding your location…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تحديد موقعك…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مقام تلاش ہو رہا ہے…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari lokasi Anda…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumunuz bulunuyor…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অবস্থান খোঁজা হচ্ছে…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de votre position…"
          }
        }
      }
    },
    "feature_onboarding_location_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't get your location. Search for your city instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد موقعك. ابحث عن مدينتك بدلًا من ذلك."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مقام نہیں مل سکا۔ اس کے بجائے اپنا شہر تلاش کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi tidak ditemukan. Cari kota Anda saja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumunuz alınamadı. Bunun yerine şehrinizi arayın."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অবস্থান পাওয়া যায়নি। এর বদলে আপনার শহর খুঁজুন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Position introuvable. Cherchez plutôt votre ville."
          }
        }
      }
    },
    "feature_onboarding_location_no_results": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No city found. Try another spelling."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نجد مدينة بهذا الاسم. جرّب كتابة أخرى."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی شہر نہیں ملا۔ کوئی اور ہجے آزمائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kota tidak ditemukan. Coba ejaan lain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şehir bulunamadı. Başka bir yazım deneyin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো শহর পাওয়া যায়নি। অন্য বানানে চেষ্টা করুন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune ville trouvée. Essayez une autre orthographe."
          }
        }
      }
    },
    "feature_onboarding_location_permission_denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is off. You can search for your city instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الموقع متوقف. يمكنك البحث عن مدينتك بدلًا من ذلك."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام کی اجازت بند ہے۔ آپ اپنا شہر تلاش کر سکتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses lokasi nonaktif. Anda bisa mencari kota Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum erişimi kapalı. Şehrinizi arayabilirsiniz."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থানের অনুমতি বন্ধ। আপনি আপনার শহর খুঁজে নিতে পারেন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la position est désactivé. Vous pouvez chercher votre ville."
          }
        }
      }
    },
