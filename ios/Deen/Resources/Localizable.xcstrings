          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز کے بعد کے اذکار"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zikir setelah salat"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz sonrası zikirler"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজের পরের জিকির"
          }
        },
