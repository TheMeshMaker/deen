    "feature_settings_voice_not_audio": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file doesn't look like a playable recording (3 seconds to 15 minutes)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يبدو الملف تسجيلًا صالحًا للتشغيل (من 3 ثوانٍ إلى 15 دقيقة)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ فائل چلنے والی ریکارڈنگ نہیں لگتی (3 سیکنڈ سے 15 منٹ تک)۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas itu tampaknya bukan rekaman yang bisa diputar (3 detik hingga 15 menit)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya çalınabilir bir kayda benzemiyor (3 saniye ile 15 dakika arası)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলটি চালানোর মতো রেকর্ডিং মনে হচ্ছে না (৩ সেকেন্ড থেকে ১৫ মিনিট)।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne semble pas être un enregistrement lisible (de 3 secondes à 15 minutes)."
          }
        }
      }
    },
