    "feature_settings_src_hadith_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arabic text, numbering and gradings of the six books, the Muwatta and the Forty Qudsi from hadith-api (Unlicense). The texts are classical and in the public domain."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نصوص الكتب الستة والموطأ والأربعين القدسية وأرقامها وأحكامها من hadith-api (Unlicense)، وهي نصوص تراثية في الملك العام."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صحاحِ ستہ، موطا اور اربعینِ قدسی کا عربی متن، نمبر اور احکام hadith-api سے (Unlicense)۔ یہ متون قدیم اور عوامی ملکیت ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks Arab, penomoran, dan derajat Kutubus Sittah, Al-Muwatta, dan Arbain Qudsiyah dari hadith-api (Unlicense). Teks-teks ini klasik dan berstatus domain publik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kütüb-i Sitte, Muvatta ve Kırk Kudsî Hadis'in Arapça metni, numaraları ve hükümleri hadith-api'den (Unlicense). Metinler klasiktir ve kamu malıdır."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিহাহ সিত্তাহ, মুয়াত্তা ও চল্লিশ হাদিসে কুদসির আরবি পাঠ, নম্বর ও মান hadith-api থেকে (Unlicense)। পাঠগুলো প্রাচীন ও জনসাধারণের সম্পত্তি।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte arabe, numérotation et jugements des six livres, du Muwatta et des quarante hadiths qudsi, issus de hadith-api (Unlicense). Ces textes sont classiques et dans le domaine public."
          }
        }
      }
    },
