    "feature_settings_masjid_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notification before the prayer, with time to walk there."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعار قبل الصلاة بوقت يكفي للذهاب."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز سے پہلے ایک اطلاع، پیدل پہنچنے کے وقت کے ساتھ۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi sebelum salat, dengan waktu untuk berjalan ke sana."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namazdan önce, yürüyerek varacak zaman bırakan bir bildirim."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজের আগে একটি নোটিফিকেশন, হেঁটে পৌঁছানোর সময় রেখে।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification avant la prière, avec le temps d’y aller à pied."
          }
        }
      }
    },
