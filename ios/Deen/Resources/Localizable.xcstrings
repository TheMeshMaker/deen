    "feature_settings_src_app_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free software under GPL-3.0-or-later. No ads, no tracking."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامج حر بترخيص GPL-3.0 أو أحدث، بلا إعلانات ولا تتبّع."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GPL-3.0 یا بعد کے لائسنس کے تحت آزاد سافٹ ویئر۔ نہ اشتہار، نہ ٹریکنگ۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat lunak bebas di bawah GPL-3.0 atau yang lebih baru. Tanpa iklan, tanpa pelacakan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GPL-3.0 veya sonrası lisanslı özgür yazılım. Reklam yok, takip yok."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GPL-3.0 বা পরবর্তী লাইসেন্সের অধীনে মুক্ত সফটওয়্যার। বিজ্ঞাপন নেই, ট্র্যাকিং নেই।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logiciel libre sous GPL-3.0 ou ultérieure. Sans publicité, sans pistage."
          }
        }
      }
    },
