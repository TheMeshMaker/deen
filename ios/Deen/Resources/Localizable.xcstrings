    "feature_settings_custom_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the two colours of the gradient. The rest of the app is coloured to match."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لونَي التدرّج، ويُلوَّن باقي التطبيق بما يناسبهما."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گریڈینٹ کے دو رنگ چنیں۔ باقی ایپ انہی کے مطابق رنگی جاتی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih dua warna gradasi. Bagian lain aplikasi menyesuaikan warnanya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçişin iki rengini seçin. Uygulamanın geri kalanı bunlara göre renklenir."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গ্রেডিয়েন্টের দুটি রং বেছে নিন। অ্যাপের বাকি অংশ সেই অনুযায়ী রঙিন হয়।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les deux couleurs du dégradé. Le reste de l’appli s’accorde avec elles."
          }
        }
      }
    },
