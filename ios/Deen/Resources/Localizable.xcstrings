    "feature_more_share_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen: prayer times, adhan, Quran and adhkar. Free and without ads. %1$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دِين: مواقيت الصلاة والأذان والقرآن والأذكار، مجانًا وبلا إعلانات. %1$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دین: نماز کے اوقات، اذان، قرآن اور اذکار۔ مفت اور بغیر اشتہارات کے۔ %1$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen: waktu salat, azan, Al-Qur'an, dan zikir. Gratis dan tanpa iklan. %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen: namaz vakitleri, ezan, Kur'an ve zikirler. Ücretsiz ve reklamsız. %1$@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen: নামাজের সময়, আজান, কুরআন ও জিকির। বিনামূল্যে ও বিজ্ঞাপনমুক্ত। %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen : heures de prière, adhan, Coran et adhkar. Gratuit et sans publicité. %1$@"
          }
        }
      }
    },
