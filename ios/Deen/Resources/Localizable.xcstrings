    "feature_more_support_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen is free, with no ads, and always will be. If it helps you, you can help it grow."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دِين مجاني بلا إعلانات وسيبقى كذلك. إن نفعك فبإمكانك أن تعين على تطويره."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دین مفت ہے، بغیر اشتہارات کے، اور ہمیشہ رہے گا۔ اگر یہ آپ کے کام آتا ہے تو آپ اسے آگے بڑھانے میں مدد کر سکتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen gratis, tanpa iklan, dan akan selalu begitu. Jika bermanfaat bagi Anda, Anda bisa membantunya berkembang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen ücretsiz ve reklamsızdır, hep öyle kalacak. Size faydalıysa gelişmesine yardım edebilirsiniz."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen বিনামূল্যে ও বিজ্ঞাপনমুক্ত, এবং সবসময় তা-ই থাকবে। এটি আপনার উপকারে এলে এর উন্নতিতে সাহায্য করতে পারেন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen est gratuit, sans publicité, et le restera. S’il vous est utile, vous pouvez l’aider à grandir."
          }
        }
      }
    },
