            "state": "translated",
            "value": "جمعہ کی صبح سورۂ کہف پڑھنے کی یاد دہانی"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat setiap Jumat pagi untuk membaca Al-Kahf"
          }
        },
        "tr": {
