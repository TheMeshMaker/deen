    "feature_more_dua": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And please remember us in your du’a."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ولا تنسونا من صالح دعائكم."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اور براہِ کرم ہمیں اپنی دعاؤں میں یاد رکھیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan mohon ingat kami dalam doa Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen bizi de dualarınızda unutmayın."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আর অনুগ্রহ করে আপনার দোয়ায় আমাদের স্মরণ রাখবেন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et souvenez-vous de nous dans vos invocations."
          }
        }
      }
    },
    "feature_more_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free and open source. No ads, no tracking."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجاني ومفتوح المصدر، بلا إعلانات ولا تتبّع."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مفت اور اوپن سورس۔ نہ اشتہار، نہ ٹریکنگ۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis dan sumber terbuka. Tanpa iklan, tanpa pelacakan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz ve açık kaynak. Reklam yok, takip yok."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিনামূল্যে ও ওপেন সোর্স। বিজ্ঞাপন নেই, ট্র্যাকিং নেই।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit et libre. Sans publicité, sans pistage."
          }
        }
      }
    },
