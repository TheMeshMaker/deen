    "feature_settings_style_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same app in four looks. Colours stay as you chose them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيق نفسه بأربعة أشكال، وتبقى الألوان كما اخترتها."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ہی ایپ چار انداز میں۔ رنگ وہی رہتے ہیں جو آپ نے چنے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi yang sama dalam empat tampilan. Warna tetap seperti pilihan Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı uygulama dört görünümde. Renkler seçtiğiniz gibi kalır."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একই অ্যাপ চার রূপে। রং আপনার বাছাই মতোই থাকে।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La même appli sous quatre apparences. Les couleurs restent celles que vous avez choisies."
          }
        }
      }
    },
