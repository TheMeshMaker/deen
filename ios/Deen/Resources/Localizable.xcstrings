    "feature_today_khatmah_complete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You finished the Quran. May Allah accept it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أتممت ختم القرآن، تقبّل الله منك."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے قرآن مکمل کر لیا۔ اللہ قبول فرمائے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah mengkhatamkan Al-Qur'an. Semoga Allah menerimanya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur'an'ı hatmettiniz. Allah kabul etsin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কুরআন খতম করেছেন। আল্লাহ কবুল করুন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez terminé le Coran. Qu'Allah l'accepte."
          }
        }
      }
    },
