    "feature_settings_src_recitation_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recitations stream from EveryAyah.com and stay on your phone after the first play. Word timings for the highlighting: quran-align by Collin Fair (CC BY 4.0)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُشغَّل التلاوات من موقع EveryAyah.com وتبقى في هاتفك بعد أول استماع. توقيت الكلمات للتظليل من مشروع quran-align لكولن فير (CC BY 4.0)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاوتیں EveryAyah.com سے چلتی ہیں اور پہلی بار سننے کے بعد فون میں رہتی ہیں۔ نمایاں کرنے کے لیے الفاظ کے اوقات: Collin Fair کا quran-align (CC BY 4.0)۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Murotal diputar dari EveryAyah.com dan tetap tersimpan di ponsel setelah diputar pertama kali. Waktu kata untuk penyorotan: quran-align oleh Collin Fair (CC BY 4.0)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilavetler EveryAyah.com'dan çalınır ve ilk dinlemeden sonra telefonda kalır. Vurgulama için kelime zamanlamaları: Collin Fair'in quran-align projesi (CC BY 4.0)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তিলাওয়াত EveryAyah.com থেকে চলে এবং প্রথমবার শোনার পর ফোনে থেকে যায়। হাইলাইটের জন্য শব্দের সময়: Collin Fair-এর quran-align (CC BY 4.0)।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les récitations sont diffusées depuis EveryAyah.com et restent sur votre téléphone après la première écoute. Minutage des mots pour la mise en surbrillance : quran-align de Collin Fair (CC BY 4.0)."
          }
        }
      }
    },
    "feature_settings_src_tafsir": {
      "extractionState": "manual",
