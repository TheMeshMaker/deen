    "core_ui_event_arafah_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasting it is recommended for those not on Hajj."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستحب صيامه لغير الحاج."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حج نہ کرنے والوں کے لیے اس کا روزہ مستحب ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dianjurkan berpuasa bagi yang tidak berhaji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacda olmayanlar için oruç tutmak tavsiye edilir."
          }
