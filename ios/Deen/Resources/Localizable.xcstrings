    "core_ui_event_ashura_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recommended fast, with the day before it too."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
