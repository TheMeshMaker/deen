    "feature_settings_privacy_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ads, no tracking, no account. Everything works offline except Quran recitations and the longer tafsirs, which download when you open them. Nothing about you is sent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا إعلانات ولا تتبّع ولا حساب. يعمل كل شيء دون إنترنت ما عدا التلاوات والتفاسير المطوّلة، فتُنزَّل عند فتحها، ولا يُرسَل عنك شيء."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نہ اشتہار، نہ ٹریکنگ، نہ اکاؤنٹ۔ تلاوتوں اور طویل تفاسیر کے علاوہ سب کچھ بغیر انٹرنیٹ کے چلتا ہے، اور وہ بھی کھولنے پر ہی ڈاؤن لوڈ ہوتی ہیں۔ آپ کے بارے میں کچھ نہیں بھیجا جاتا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa iklan, tanpa pelacakan, tanpa akun. Semuanya bekerja tanpa internet kecuali murotal dan tafsir yang lebih panjang, yang diunduh saat Anda membukanya. Tidak ada data tentang Anda yang dikirim."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklam yok, takip yok, hesap yok. Tilavetler ve uzun tefsirler dışında her şey internetsiz çalışır; onlar da yalnızca açtığınızda indirilir. Sizinle ilgili hiçbir şey gönderilmez."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিজ্ঞাপন নেই, ট্র্যাকিং নেই, অ্যাকাউন্ট নেই। তিলাওয়াত ও দীর্ঘ তাফসির ছাড়া সবকিছু ইন্টারনেট ছাড়াই চলে, আর সেগুলোও খুললে তবেই ডাউনলোড হয়। আপনার সম্পর্কে কিছুই পাঠানো হয় না।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans publicité, sans pistage, sans compte. Tout fonctionne hors ligne sauf les récitations et les tafsirs plus longs, téléchargés quand vous les ouvrez. Rien vous concernant n’est envoyé."
          }
        }
      }
    },
