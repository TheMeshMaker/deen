    "feature_settings_haptics_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A light tap on each count in the tasbih and adhkar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقرة خفيفة مع كل عدّة في السبحة والأذكار."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تسبیح اور اذکار میں ہر گنتی پر ہلکی سی تھپک۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketukan ringan pada setiap hitungan di tasbih dan zikir."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesbih ve zikirlerde her sayımda hafif bir dokunuş."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তাসবিহ ও জিকিরে প্রতি গণনায় হালকা স্পর্শ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une légère touche à chaque compte du tasbih et des adhkar."
          }
        }
      }
    },
    "feature_settings_kahf": {
