    "feature_widget_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next prayer with a countdown, and today's times."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصلاة القادمة مع العدّ التنازلي، ومواقيت اليوم."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الٹی گنتی کے ساتھ اگلی نماز اور آج کے اوقات۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salat berikutnya dengan hitung mundur, dan jadwal hari ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri sayımlı sonraki namaz ve bugünün vakitleri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাউন্টডাউনসহ পরের নামাজ এবং আজকের সময়।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine prière avec compte à rebours, et les heures du jour."
          }
        }
      }
    },
