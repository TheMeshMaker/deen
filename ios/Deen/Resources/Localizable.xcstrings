    "feature_settings_voice_pick_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick any audio file on your phone, up to 25 MB. Deen keeps its own copy, so it still plays if you move or delete the original."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أي ملف صوتي من هاتفك، حتى 25 ميغابايت. يحتفظ دِين بنسخة منه، فيعمل حتى لو نقلت الأصل أو حذفته."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے فون سے کوئی بھی آڈیو فائل چنیں، 25 MB تک۔ دین اس کی اپنی کاپی رکھتا ہے، اس لیے اصل فائل ہٹانے پر بھی یہ چلتی رہے گی۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berkas audio apa pun di ponsel Anda, hingga 25 MB. Deen menyimpan salinannya sendiri, jadi tetap berbunyi meski aslinya dipindah atau dihapus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuzdan 25 MB'a kadar herhangi bir ses dosyası seçin. Deen kendi kopyasını tutar; orijinali taşısanız veya silseniz de çalar."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফোন থেকে ২৫ MB পর্যন্ত যেকোনো অডিও ফাইল বেছে নিন। Deen নিজের একটি কপি রাখে, তাই মূল ফাইল সরালে বা মুছলেও এটি বাজবে।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez n’importe quel fichier audio de votre téléphone, jusqu’à 25 Mo. Deen en garde sa propre copie : il joue même si vous déplacez ou supprimez l’original."
          }
        }
      }
    },
