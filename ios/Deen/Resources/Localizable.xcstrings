    "core_alarm_after_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adhkar after prayer"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
