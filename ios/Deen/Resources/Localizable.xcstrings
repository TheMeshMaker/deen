    "feature_qibla_calibrate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compass needs calibrating: move the phone in a figure 8 a few times."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البوصلة تحتاج إلى معايرة: حرّك الهاتف على شكل رقم ٨ عدة مرات."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قطب نما کو درست کرنا ہے: فون کو چند بار 8 کی شکل میں گھمائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompas perlu dikalibrasi: gerakkan ponsel membentuk angka 8 beberapa kali."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusulanın ayarlanması gerekiyor: telefonu birkaç kez 8 çizerek hareket ettirin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম্পাস ঠিক করতে হবে: ফোনটি কয়েকবার ৮-এর আকারে ঘোরান।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La boussole doit être calibrée : décrivez un 8 avec le téléphone plusieurs fois."
          }
        }
      }
    },
    "feature_qibla_distance": {
      "extractionState": "manual",
