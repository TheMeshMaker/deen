        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যারা হজে নেই তাদের জন্য রোজা রাখা মুস্তাহাব।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeûne est recommandé à ceux qui ne font pas le Hajj."
          }
        }
      }
    },
