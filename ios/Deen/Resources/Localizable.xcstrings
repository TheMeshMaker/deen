    "feature_quran_khatmah_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how many days to finish the Quran in. Deen divides the 604 pages of the Madani Mushaf into daily portions and follows your progress as you read."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر عدد الأيام لختم القرآن. يقسّم «دين» صفحات المصحف المدني الـ٦٠٤ إلى أوراد يومية ويتابع تقدّمك وأنت تقرأ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کریں کہ قرآن کتنے دنوں میں ختم کرنا ہے۔ دین مدنی مصحف کے 604 صفحات کو روزانہ حصوں میں بانٹ کر آپ کی پیش رفت دیکھتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berapa hari untuk mengkhatamkan Al-Qur'an. Deen membagi 604 halaman Mushaf Madinah menjadi bagian harian dan mengikuti kemajuan Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur'an'ı kaç günde bitireceğinizi seçin. Deen, Medine Mushafı'nın 604 sayfasını günlük bölümlere ayırır ve okudukça ilerlemenizi takip eder."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কত দিনে কুরআন খতম করবেন বেছে নিন। দীন মাদানি মুসহাফের ৬০৪ পৃষ্ঠাকে দৈনিক অংশে ভাগ করে আপনার অগ্রগতি অনুসরণ করে।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez en combien de jours terminer le Coran. Deen répartit les 604 pages du Mushaf de Médine en parts quotidiennes et suit votre progression."
          }
        }
      }
    },
    "feature_quran_khatmah_complete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed. May Allah accept it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمّت الختمة، تقبّل الله منك."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مکمل ہو گیا۔ اللہ قبول فرمائے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesai. Semoga Allah menerimanya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlandı. Allah kabul etsin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পন্ন। আল্লাহ কবুল করুন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé. Qu'Allah l'accepte."
          }
        }
      }
    },
