        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشروع تنزيل، النص العثماني 1.1، كما هو دون تغيير، بترخيص CC BY 3.0. الخط: أميري قرآن."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تنزیل پروجیکٹ، عثمانی متن 1.1، بغیر تبدیلی کے CC BY 3.0 کے تحت۔ فونٹ: Amiri Quran۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek Tanzil, teks Utsmani 1.1, digunakan apa adanya di bawah CC BY 3.0. Fon: Amiri Quran."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanzil Projesi, Osmanlı hattı metin 1.1, CC BY 3.0 ile değiştirilmeden kullanılmıştır. Yazı tipi: Amiri Quran."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তানজিল প্রকল্প, উসমানি পাঠ ১.১, অপরিবর্তিতভাবে CC BY 3.0-এর অধীনে ব্যবহৃত। ফন্ট: Amiri Quran।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
