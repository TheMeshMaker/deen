    "feature_quran_reciter_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recitations stream from everyayah.com and are kept on your phone after the first play."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُشغَّل التلاوات من موقع everyayah.com، وتُحفظ في هاتفك بعد أول استماع."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاوتیں everyayah.com سے چلتی ہیں اور پہلی بار سننے کے بعد فون میں محفوظ رہتی ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Murotal diputar dari everyayah.com dan disimpan di ponsel Anda setelah diputar pertama kali."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilavetler everyayah.com'dan çalınır ve ilk dinlemeden sonra telefonunuzda saklanır."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তিলাওয়াত everyayah.com থেকে চলে এবং প্রথমবার শোনার পর আপনার ফোনে থেকে যায়।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les récitations sont diffusées depuis everyayah.com et restent sur votre téléphone après la première écoute."
          }
        }
      }
    },
