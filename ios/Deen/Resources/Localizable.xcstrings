    "feature_settings_src_english": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "English translations"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترجمات الإنجليزية"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انگریزی تراجم"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan bahasa Inggris"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İngilizce çeviriler"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইংরেজি অনুবাদ"
          }
