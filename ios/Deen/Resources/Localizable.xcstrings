    "feature_onboarding_method_asr_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Ḥanafī school, ʿAsr begins later."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ وقت العصر متأخرًا في المذهب الحنفي."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حنفی مسلک میں عصر کا وقت دیر سے شروع ہوتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam mazhab Hanafi, waktu Asar dimulai lebih lambat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanefî mezhebinde ikindi vakti daha geç başlar."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হানাফি মাজহাবে আসরের সময় পরে শুরু হয়।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l’école hanafite, l’Asr commence plus tard."
          }
        }
      }
    },
