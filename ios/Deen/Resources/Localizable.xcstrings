    "feature_adhkar_tap_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a card each time you say it. It moves on by itself when done."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على البطاقة كلما قلت الذكر، وتنتقل وحدها عند اكتماله."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر بار پڑھنے پر کارڈ کو تھپتھپائیں۔ مکمل ہونے پر یہ خود آگے بڑھ جاتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk kartu setiap kali Anda membacanya. Kartu berpindah sendiri saat selesai."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her okuduğunuzda karta dokunun. Bitince kendiliğinden sonrakine geçer."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিবার পড়ার পর কার্ডে ট্যাপ করুন। শেষ হলে এটি নিজেই এগিয়ে যায়।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la carte à chaque récitation. Elle passe d’elle-même à la suivante une fois terminée."
          }
        }
      }
    },
