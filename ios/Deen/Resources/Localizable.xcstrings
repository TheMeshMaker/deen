    "feature_settings_fajr_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bundled recordings are the regular adhan. For Fajr you can choose your own recording that includes “as-salātu khayrun mina-n-nawm”."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيلات المرفقة هي الأذان المعتاد. ويمكنك أن تختار لأذان الفجر تسجيلًا خاصًا فيه «الصلاة خير من النوم»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شامل ریکارڈنگز عام اذان ہیں۔ فجر کے لیے آپ اپنی ریکارڈنگ چن سکتے ہیں جس میں “الصلاة خير من النوم” ہو۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman bawaan adalah azan biasa. Untuk Subuh Anda bisa memilih rekaman sendiri yang memuat “ash-shalatu khairun minan naum”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadaki kayıtlar normal ezandır. Sabah için “es-salâtü hayrun mine'n-nevm” içeren kendi kaydınızı seçebilirsiniz."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপে থাকা রেকর্ডিংগুলো সাধারণ আজান। ফজরের জন্য আপনি “আস-সালাতু খাইরুম মিনান নাউম” সহ নিজের রেকর্ডিং বেছে নিতে পারেন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements fournis sont l’adhan habituel. Pour le Fajr, vous pouvez choisir votre propre enregistrement contenant « as-salatou khayroun mina-n-nawm »."
          }
        }
      }
    },
