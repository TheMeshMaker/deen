    "feature_settings_src_adhkar_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morning and evening adhkar in the wording of Hisn al-Muslim, from Seen-Arabic (MIT). Other adhkar taken from the cited hadith and checked against them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أذكار الصباح والمساء بلفظ حصن المسلم من مشروع Seen-Arabic (MIT)، وبقية الأذكار من الأحاديث المذكورة مع مطابقتها بها."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صبح و شام کے اذکار حصن المسلم کے الفاظ میں، Seen-Arabic سے (MIT)۔ باقی اذکار مذکورہ احادیث سے لیے گئے اور ان سے ملائے گئے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zikir pagi dan petang dengan lafaz Hisnul Muslim, dari Seen-Arabic (MIT). Zikir lainnya diambil dari hadis yang disebut dan dicocokkan dengannya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah ve akşam zikirleri Hısnü'l-Müslim lafzıyla, Seen-Arabic'ten (MIT). Diğer zikirler adı geçen hadislerden alınmış ve onlarla karşılaştırılmıştır."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সকাল-সন্ধ্যার জিকির হিসনুল মুসলিমের শব্দে, Seen-Arabic থেকে (MIT)। অন্যান্য জিকির উল্লিখিত হাদিস থেকে নেওয়া ও সেগুলোর সাথে মেলানো।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adhkar du matin et du soir dans la formulation de Hisn al-Muslim, de Seen-Arabic (MIT). Les autres adhkar sont tirés des hadiths cités et vérifiés avec eux."
          }
        }
      }
    },
