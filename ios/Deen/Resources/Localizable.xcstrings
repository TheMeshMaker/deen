    "feature_timetable_calendar_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates follow the Umm al-Qura calendar with your Hijri adjustment. Local moon sighting may differ by a day."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التواريخ وفق تقويم أم القرى مع تعديلك للتاريخ الهجري، وقد تختلف رؤية الهلال المحلية بيوم."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخیں ام القریٰ کیلنڈر اور آپ کی ہجری ترمیم کے مطابق ہیں۔ مقامی رؤیتِ ہلال میں ایک دن کا فرق ہو سکتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal mengikuti kalender Ummul Qura dengan penyesuaian Hijriah Anda. Rukyat setempat bisa berbeda sehari."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarihler, hicri düzeltmenizle Ümmü'l-Kura takvimine göredir. Yerel hilal gözlemi bir gün farklı olabilir."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তারিখগুলো উম্মুল কুরা ক্যালেন্ডার ও আপনার হিজরি সমন্বয় অনুযায়ী। স্থানীয় চাঁদ দেখায় এক দিনের পার্থক্য হতে পারে।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dates suivent le calendrier Umm al-Qura avec votre ajustement hégirien. L'observation locale de la lune peut différer d'un jour."
          }
        }
      }
    },
