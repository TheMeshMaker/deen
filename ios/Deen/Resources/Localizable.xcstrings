          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudahkah Anda salat %1$@?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ namazını kıldınız mı?"
