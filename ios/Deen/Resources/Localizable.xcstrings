    "feature_settings_after_adhan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind me to pray after the adhan"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذكّرني بالصلاة بعد الأذان"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اذان کے بعد مجھے نماز کی یاد دلائیں"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingatkan saya salat setelah azan"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezandan sonra namazı hatırlat"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজানের পরে নামাজের কথা মনে করিয়ে দিন"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Me rappeler de prier après l’adhan"
          }
        }
      }
    },
    "feature_settings_after_adhan_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. A gentle nudge a few minutes after each adhan; choose the time for each prayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري: تذكير لطيف بعد كل أذان بدقائق، وتختار الوقت لكل صلاة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اختیاری۔ ہر اذان کے چند منٹ بعد ایک ہلکی یاد دہانی؛ ہر نماز کا وقت الگ چنیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional. Pengingat lembut beberapa menit setelah setiap azan; pilih waktunya untuk tiap salat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Her ezandan birkaç dakika sonra nazik bir hatırlatma; her namaz için süreyi seçin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐচ্ছিক। প্রতিটি আজানের কয়েক মিনিট পরে একটি কোমল রিমাইন্ডার; প্রতিটি নামাজের জন্য সময় বেছে নিন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Un doux rappel quelques minutes après chaque adhan ; choisissez le délai pour chaque prière."
          }
        }
      }
    },
