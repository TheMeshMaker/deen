    "feature_timetable_sunnah_fasts_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mondays and Thursdays, and the white days (13th–15th) of every Hijri month."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإثنين والخميس، والأيام البيض (١٣–١٥) من كل شهر هجري."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پیر اور جمعرات، اور ہر ہجری مہینے کے ایامِ بیض (13–15)۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Senin dan Kamis, serta hari-hari putih (13–15) setiap bulan Hijriah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazartesi ve perşembe günleri ile her hicri ayın 13–15. günleri."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সোমবার ও বৃহস্পতিবার, এবং প্রতি হিজরি মাসের আইয়ামে বীয (১৩–১৫)।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lundis et jeudis, et les jours blancs (13–15) de chaque mois hégirien."
          }
        }
      }
    },
