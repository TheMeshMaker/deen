    "feature_qibla_no_compass": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone has no compass. Use the bearing below with a compass."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد في هذا الهاتف بوصلة. استخدم الاتجاه أدناه مع بوصلة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فون میں قطب نما نہیں ہے۔ نیچے دیا گیا زاویہ کسی قطب نما کے ساتھ استعمال کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel ini tidak memiliki kompas. Gunakan sudut di bawah dengan kompas biasa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefonda pusula yok. Aşağıdaki açıyı bir pusulayla kullanın."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোনে কম্পাস নেই। নিচের কোণটি একটি কম্পাসের সাথে ব্যবহার করুন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone n’a pas de boussole. Utilisez l’angle ci-dessous avec une boussole."
          }
        }
      }
    },
    "feature_qibla_no_location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your location first, from Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد موقعك أولًا من الإعدادات."
          }
        },
        "ur": {
          "stringUnit": {
