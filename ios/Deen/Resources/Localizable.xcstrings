          }
        }
      }
    },
    "feature_settings_src_english_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The English of the adhkar, an-Nawawi's Forty and the facts about the Prophet ﷺ was written for Deen and is awaiting review by a qualified reviewer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترجمة الإنجليزية للأذكار والأربعين النووية ومعلومات السيرة كُتبت لدِين، وهي بانتظار مراجعة مختص."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اذکار، اربعینِ نووی اور نبی ﷺ کے بارے میں باتوں کا انگریزی ترجمہ دین کے لیے لکھا گیا اور کسی مستند عالم کی نظرِ ثانی کا منتظر ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan Inggris untuk zikir, Arbain Nawawi, dan fakta tentang Nabi ﷺ ditulis untuk Deen dan sedang menunggu tinjauan oleh peninjau yang berkompeten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zikirlerin, Nevevî'nin Kırk Hadisi'nin ve Peygamber ﷺ hakkındaki bilgilerin İngilizcesi Deen için yazıldı ve ehil bir kişinin incelemesini bekliyor."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জিকির, ইমাম নববীর চল্লিশ হাদিস ও নবী ﷺ সম্পর্কিত তথ্যের ইংরেজি Deen-এর জন্য লেখা এবং একজন যোগ্য পর্যালোচকের পর্যালোচনার অপেক্ষায়।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anglais des adhkar, des quarante hadiths d’an-Nawawi et des faits sur le Prophète ﷺ a été écrit pour Deen et attend la relecture d’une personne qualifiée."
          }
        }
      }
    },
