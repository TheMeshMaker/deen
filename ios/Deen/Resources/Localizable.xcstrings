        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি %1$@ নামাজ পড়েছেন?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous prié %1$@ ?"
