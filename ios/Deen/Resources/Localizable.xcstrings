    "feature_onboarding_method_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the method your local mosque follows. You can change it any time."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الطريقة التي يعتمدها مسجدك، ويمكنك تغييرها في أي وقت."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ طریقہ منتخب کریں جس پر آپ کی مقامی مسجد چلتی ہے۔ آپ اسے کبھی بھی بدل سکتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih metode yang diikuti masjid setempat Anda. Anda bisa mengubahnya kapan saja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel caminizin uyduğu yöntemi seçin. İstediğiniz zaman değiştirebilirsiniz."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার এলাকার মসজিদ যে পদ্ধতি অনুসরণ করে তা বেছে নিন। যেকোনো সময় বদলাতে পারবেন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la méthode suivie par votre mosquée. Vous pourrez la changer à tout moment."
          }
        }
      }
    },
