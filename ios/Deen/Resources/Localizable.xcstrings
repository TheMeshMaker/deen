            "state": "translated",
            "value": "Qibla: %1$@° from true north"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القبلة: %1$@° من الشمال الجغرافي"
          }
        },
        "ur": {
