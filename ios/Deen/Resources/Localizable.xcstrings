    "core_ui_event_white_days_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 13th to 15th of the Hijri month: recommended days to fast."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الثالث عشر إلى الخامس عشر من الشهر الهجري: يُستحب صيامها."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہجری مہینے کی تیرہ سے پندرہ تاریخ: روزے کے مستحب دن۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal 13 sampai 15 bulan Hijriah: hari yang dianjurkan berpuasa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hicri ayın 13-15. günleri: oruç tutulması tavsiye edilen günler."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হিজরি মাসের ১৩ থেকে ১৫ তারিখ: রোজা রাখার মুস্তাহাব দিন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du 13 au 15 du mois hégirien : jours de jeûne recommandés."
          }
        }
      }
    },
