    "feature_reliability_step_background": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-start and background activity"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التشغيل التلقائي والعمل في الخلفية"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خودکار آغاز اور پس منظر کی سرگرمی"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai otomatis dan aktivitas latar belakang"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik başlatma ve arka plan etkinliği"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অটো-স্টার্ট ও ব্যাকগ্রাউন্ড কার্যকলাপ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrage auto et activité en arrière-plan"
          }
        }
      }
    },
    "feature_reliability_step_background_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many phones add their own limits on top of Android, called auto-start, app launch or background activity. If yours has one, allow it for Deen. If you can't find it, your phone doesn't need it: just tick the box."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تضيف هواتف كثيرة قيودًا خاصة بها فوق أندرويد، باسم التشغيل التلقائي أو تشغيل التطبيقات أو النشاط في الخلفية. إن وُجد هذا الإعداد في هاتفك فاسمح به لدِين، وإن لم تجده فهاتفك لا يحتاجه: ضع علامة فقط."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بہت سے فون اینڈرائیڈ کے اوپر اپنی پابندیاں لگاتے ہیں، جنہیں خودکار آغاز، ایپ لانچ یا پس منظر کی سرگرمی کہا جاتا ہے۔ اگر آپ کے فون میں ایسا ہے تو دین کو اجازت دیں۔ اگر نہ ملے تو آپ کے فون کو اس کی ضرورت نہیں: بس خانے پر نشان لگا دیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Banyak ponsel menambahkan batasan sendiri di atas Android, disebut mulai otomatis, peluncuran aplikasi, atau aktivitas latar belakang. Jika ponsel Anda memilikinya, izinkan untuk Deen. Jika tidak menemukannya, ponsel Anda tidak memerlukannya: cukup centang kotaknya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birçok telefon Android'in üzerine otomatik başlatma, uygulama başlatma veya arka plan etkinliği gibi kendi sınırlarını ekler. Sizinkinde varsa Deen'e izin verin. Bulamıyorsanız telefonunuzun buna ihtiyacı yoktur: kutuyu işaretlemeniz yeterli."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনেক ফোন অ্যান্ড্রয়েডের ওপর নিজস্ব সীমা যোগ করে, যেমন অটো-স্টার্ট, অ্যাপ লঞ্চ বা ব্যাকগ্রাউন্ড কার্যকলাপ। আপনার ফোনে থাকলে Deen-কে অনুমতি দিন। খুঁজে না পেলে আপনার ফোনের এটি দরকার নেই: শুধু বাক্সে টিক দিন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaucoup de téléphones ajoutent leurs propres limites à Android : démarrage automatique, lancement d’application ou activité en arrière-plan. Si le vôtre en a, autorisez-le pour Deen. Si vous ne trouvez rien, votre téléphone n’en a pas besoin : cochez simplement la case."
          }
        }
      }
    },
    "feature_reliability_step_battery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery: unrestricted"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البطارية: دون قيود"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بیٹری: بغیر پابندی"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baterai: tidak dibatasi"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pil: kısıtlamasız"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাটারি: সীমাবদ্ধ নয়"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterie : sans restriction"
          }
        }
      }
    },
    "feature_reliability_step_battery_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Otherwise the battery saver can hold the adhan back. If your phone asks, choose “Allow background activity” or “Unrestricted”."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وإلا قد يؤخّر موفّر البطارية الأذان. إذا سألك الهاتف فاختر «السماح بالنشاط في الخلفية» أو «دون قيود»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ورنہ بیٹری سیور اذان کو روک سکتا ہے۔ اگر فون پوچھے تو “پس منظر کی سرگرمی کی اجازت” یا “بغیر پابندی” منتخب کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tidak, penghemat baterai bisa menahan azan. Jika ponsel bertanya, pilih “Izinkan aktivitas latar belakang” atau “Tidak dibatasi”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksi halde pil tasarrufu ezanı geciktirebilir. Telefon sorarsa “Arka plan etkinliğine izin ver” veya “Kısıtlamasız” seçin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নইলে ব্যাটারি সেভার আজান আটকে দিতে পারে। ফোন জিজ্ঞেস করলে “ব্যাকগ্রাউন্ড কার্যকলাপের অনুমতি দিন” বা “সীমাবদ্ধ নয়” বেছে নিন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon l’économiseur de batterie peut retarder l’adhan. Si le téléphone le demande, choisissez « Autoriser l’activité en arrière-plan » ou « Sans restriction »."
          }
        }
      }
    },
    "feature_reliability_step_exact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact alarms"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنبّهات الدقيقة"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درست الارم"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm tepat waktu"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam zamanlı alarmlar"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্ভুল অ্যালার্ম"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmes exactes"
          }
        }
      }
    },
    "feature_reliability_step_exact_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So the adhan starts on time, not minutes late."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليبدأ الأذان في وقته تمامًا، لا متأخرًا بدقائق."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاکہ اذان وقت پر شروع ہو، چند منٹ دیر سے نہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar azan dimulai tepat waktu, bukan terlambat beberapa menit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezan dakikalarca gecikmeden tam vaktinde başlasın diye."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাতে আজান কয়েক মিনিট দেরিতে নয়, ঠিক সময়ে শুরু হয়।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que l’adhan démarre à l’heure, pas avec des minutes de retard."
          }
        }
      }
    },
    "feature_reliability_step_notifications": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটিফিকেশন"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        }
      }
    },
    "feature_reliability_step_notifications_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So the adhan can show the prayer's name and a Stop button."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليظهر اسم الصلاة وزر الإيقاف مع الأذان."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاکہ اذان نماز کا نام اور بند کرنے کا بٹن دکھا سکے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar azan dapat menampilkan nama salat dan tombol Hentikan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezan, namazın adını ve Durdur düğmesini gösterebilsin diye."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাতে আজান নামাজের নাম ও বন্ধ বোতাম দেখাতে পারে।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que l’adhan affiche le nom de la prière et un bouton Arrêter."
          }
        }
      }
    },
    "feature_reliability_step_recents": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock Deen in recent apps"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت دِين في التطبيقات الأخيرة"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حالیہ ایپس میں دین کو لاک کریں"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci Deen di aplikasi terbaru"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen'i son uygulamalarda kilitleyin"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাম্প্রতিক অ্যাপে Deen লক করুন"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller Deen dans les applis récentes"
          }
        }
      }
    },
    "feature_reliability_step_recents_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On some phones, clearing recent apps also stops their alarms. Open recent apps, long-press Deen's card (or swipe it down) and tap Lock if your phone offers it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في بعض الهواتف يوقف مسحُ التطبيقات الأخيرة منبّهاتِها أيضًا. افتح التطبيقات الأخيرة واضغط مطوّلًا على بطاقة دِين (أو اسحبها للأسفل) واختر «قفل» إن كان هاتفك يتيح ذلك."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ فونز پر حالیہ ایپس صاف کرنے سے ان کے الارم بھی رک جاتے ہیں۔ حالیہ ایپس کھولیں، دین کے کارڈ کو دیر تک دبائیں (یا نیچے سوائپ کریں) اور اگر فون میں ہو تو لاک دبائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di beberapa ponsel, membersihkan aplikasi terbaru juga menghentikan alarmnya. Buka aplikasi terbaru, tekan lama kartu Deen (atau geser ke bawah) lalu ketuk Kunci jika tersedia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı telefonlarda son uygulamaları temizlemek alarmlarını da durdurur. Son uygulamaları açın, Deen kartına uzun basın (veya aşağı kaydırın) ve varsa Kilitle'ye dokunun."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু ফোনে সাম্প্রতিক অ্যাপ মুছলে সেগুলোর অ্যালার্মও বন্ধ হয়ে যায়। সাম্প্রতিক অ্যাপ খুলুন, Deen-এর কার্ডে দীর্ঘক্ষণ চাপুন (বা নিচে সোয়াইপ করুন) এবং থাকলে লক চাপুন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur certains téléphones, vider les applis récentes arrête aussi leurs alarmes. Ouvrez les applis récentes, appuyez longuement sur la carte de Deen (ou balayez-la vers le bas) et touchez Verrouiller si votre téléphone le propose."
          }
        }
      }
    },
    "feature_reliability_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few settings so Android never silences the adhan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بضعة إعدادات حتى لا يُسكت أندرويد الأذان أبدًا."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چند ترتیبات تاکہ اینڈرائیڈ کبھی اذان کو خاموش نہ کرے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa pengaturan agar Android tidak pernah membungkam azan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android'in ezanı asla susturmaması için birkaç ayar."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কয়েকটি সেটিং, যাতে অ্যান্ড্রয়েড কখনো আজান থামিয়ে না দেয়।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques réglages pour qu’Android ne coupe jamais l’adhan."
          }
        }
      }
    },
    "feature_reliability_test_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the button, lock your phone and wait one minute. If you hear the adhan, everything works."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط الزر ثم اقفل هاتفك وانتظر دقيقة. إذا سمعت الأذان فكل شيء يعمل."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بٹن دبائیں، فون لاک کریں اور ایک منٹ انتظار کریں۔ اگر اذان سنائی دے تو سب ٹھیک ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombol, kunci ponsel, dan tunggu satu menit. Jika azan terdengar, semuanya berfungsi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düğmeye dokunun, telefonu kilitleyin ve bir dakika bekleyin. Ezanı duyarsanız her şey çalışıyor demektir."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বোতামে ট্যাপ করুন, ফোন লক করুন এবং এক মিনিট অপেক্ষা করুন। আজান শুনলে সব ঠিক আছে।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton, verrouillez le téléphone et attendez une minute. Si vous entendez l’adhan, tout fonctionne."
          }
        }
      }
    },
