    "ios_test_scheduled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The test adhan rings in about a minute. Lock your phone now."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيرنّ الأذان التجريبي بعد دقيقة تقريبًا. اقفل هاتفك الآن."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آزمائشی اذان تقریباً ایک منٹ میں بجے گی۔ اب اپنا فون لاک کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Azan uji akan berbunyi sekitar satu menit lagi. Kunci ponsel Anda sekarang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme ezanı yaklaşık bir dakika içinde çalacak. Şimdi telefonunuzu kilitleyin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরীক্ষামূলক আজান প্রায় এক মিনিটে বাজবে। এখন ফোন লক করুন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adhan d’essai sonnera dans une minute environ. Verrouillez votre téléphone maintenant."
          }
        }
      }
    },
