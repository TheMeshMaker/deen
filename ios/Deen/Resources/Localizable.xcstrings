          }
        }
      }
    },
    "feature_hadith_facts_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short facts from the hadith · one each day"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معلومات قصيرة من الأحاديث · واحدة كل يوم"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "احادیث سے مختصر باتیں · روزانہ ایک"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fakta singkat dari hadis · satu setiap hari"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadislerden kısa bilgiler · her gün bir tane"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হাদিস থেকে ছোট তথ্য · প্রতিদিন একটি"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courts faits tirés des hadiths · un par jour"
          }
        }
      }
    },
    "feature_hadith_facts_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Facts about the Prophet ﷺ, each taken from the hadith named under it. A new one appears on the Today screen every day."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معلومات عن النبي ﷺ، كل واحدة مأخوذة من الحديث المذكور تحتها، وتظهر واحدة جديدة كل يوم في الشاشة الرئيسية."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نبی ﷺ کے بارے میں باتیں، ہر ایک اپنے نیچے دی گئی حدیث سے لی گئی ہے۔ ہر روز ایک نئی بات آج کی اسکرین پر آتی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fakta tentang Nabi ﷺ, masing-masing diambil dari hadis yang disebut di bawahnya. Satu fakta baru tampil di layar Hari ini setiap hari."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peygamber ﷺ hakkında bilgiler; her biri altında adı geçen hadisten alınmıştır. Bugün ekranında her gün yenisi çıkar."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নবী ﷺ সম্পর্কে তথ্য, প্রতিটি তার নিচে উল্লিখিত হাদিস থেকে নেওয়া। প্রতিদিন আজ স্ক্রিনে একটি নতুন তথ্য আসে।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des faits sur le Prophète ﷺ, chacun tiré du hadith cité en dessous. Un nouveau s’affiche chaque jour sur l’écran Aujourd’hui."
          }
        }
      }
    },
    "feature_hadith_graded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each hadith shows a scholar's grading: green authentic, blue good, amber weak, red fabricated."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر مع كل حديث حكم أحد العلماء: الأخضر صحيح، والأزرق حسن، والبرتقالي ضعيف، والأحمر موضوع."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر حدیث پر کسی عالم کا حکم درج ہے: سبز صحیح، نیلا حسن، زرد ضعیف، سرخ موضوع۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap hadis menampilkan derajat dari seorang ulama: hijau sahih, biru hasan, kuning daif, merah palsu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her hadiste bir âlimin hükmü yer alır: yeşil sahih, mavi hasen, sarı zayıf, kırmızı uydurma."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি হাদিসে একজন আলেমের মান দেখানো হয়: সবুজ সহিহ, নীল হাসান, হলুদ দুর্বল, লাল জাল।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque hadith indique le jugement d’un savant : vert authentique, bleu bon, ambre faible, rouge inventé."
          }
        }
      }
    },
