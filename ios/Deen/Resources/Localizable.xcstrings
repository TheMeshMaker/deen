          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دِين مجاني ومفتوح المصدر، وكل نص وتسجيل فيه من مصدر معروف بترخيص يسمح باستخدامه."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دین مفت اور اوپن سورس ہے۔ ہر متن اور ریکارڈنگ ایک معلوم ماخذ سے ایسے لائسنس کے تحت ہے جو اس کی اجازت دیتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen gratis dan bersumber terbuka. Setiap teks dan rekaman berasal dari sumber yang disebut dengan lisensi yang mengizinkannya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen ücretsiz ve açık kaynaktır. Her metin ve kayıt, buna izin veren bir lisansla, adı belli bir kaynaktan gelir."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen বিনামূল্যে ও ওপেন সোর্স। প্রতিটি লেখা ও রেকর্ডিং একটি নির্দিষ্ট সূত্র থেকে, এমন লাইসেন্সে যা তা অনুমোদন করে।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deen est gratuit et libre. Chaque texte et chaque enregistrement provient d’une source nommée, sous une licence qui le permet."
          }
        }
      }
    },
