    "feature_onboarding_welcome_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your daily companion for prayer, the Quran and remembering Allah."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفيقك اليومي للصلاة والقرآن وذكر الله."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز، قرآن اور اللہ کے ذکر کے لیے آپ کا روزانہ کا ساتھی۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teman harian Anda untuk salat, Al-Qur'an, dan berzikir kepada Allah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz, Kur'an ve Allah'ı anmak için günlük yol arkadaşınız."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজ, কুরআন ও আল্লাহর জিকিরের জন্য আপনার প্রতিদিনের সঙ্গী।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compagnon quotidien pour la prière, le Coran et le rappel d’Allah."
          }
        }
      }
    },
