    "feature_settings_about": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حول التطبيق"
          }
