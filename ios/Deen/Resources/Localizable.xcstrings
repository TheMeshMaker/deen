    "feature_today_tracker_private": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your tracker stays on this phone. Nothing is sent anywhere."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى متابعتك على هذا الهاتف، ولا يُرسل منها شيء."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ٹریکر اسی فون پر رہتا ہے۔ کچھ بھی کہیں نہیں بھیجا جاتا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan Anda tetap di ponsel ini. Tidak ada yang dikirim ke mana pun."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takibiniz bu telefonda kalır. Hiçbir yere gönderilmez."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ট্র্যাকার এই ফোনেই থাকে। কোথাও কিছু পাঠানো হয় না।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre suivi reste sur ce téléphone. Rien n'est envoyé."
          }
        }
      }
    },
