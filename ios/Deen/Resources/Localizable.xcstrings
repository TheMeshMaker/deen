    "feature_quran_tafsir_offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tafsir downloads the first time you open a surah. Connect to the internet and try again, or choose al-Jalalayn, which works offline."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنزَّل هذا التفسير أول مرة تفتح فيها السورة. اتصل بالإنترنت وحاول مرة أخرى، أو اختر تفسير الجلالين فهو يعمل دون إنترنت."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ تفسیر کسی سورت کو پہلی بار کھولنے پر ڈاؤن لوڈ ہوتی ہے۔ انٹرنیٹ سے جڑ کر دوبارہ کوشش کریں، یا تفسیرِ جلالین منتخب کریں جو بغیر انٹرنیٹ کے چلتی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafsir ini diunduh saat pertama kali Anda membuka sebuah surah. Sambungkan ke internet dan coba lagi, atau pilih Tafsir Jalalain yang bisa dibaca tanpa internet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tefsir bir sureyi ilk açtığınızda indirilir. İnternete bağlanıp tekrar deneyin ya da internetsiz çalışan Celâleyn tefsirini seçin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো সূরা প্রথমবার খুললে এই তাফসির ডাউনলোড হয়। ইন্টারনেটে যুক্ত হয়ে আবার চেষ্টা করুন, অথবা ইন্টারনেট ছাড়া চলে এমন তাফসিরে জালালাইন বেছে নিন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tafsir se télécharge la première fois que vous ouvrez une sourate. Connectez-vous à Internet et réessayez, ou choisissez al-Jalalayn, qui fonctionne hors ligne."
          }
        }
      }
    },
