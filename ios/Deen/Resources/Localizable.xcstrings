    "core_alarm_test_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you hear this with the screen locked, the adhan works on this phone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا سمعته والشاشة مقفلة، فالأذان يعمل على هذا الهاتف."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اسکرین لاک ہونے پر یہ سنائی دے تو اس فون پر اذان کام کرتی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda mendengar ini saat layar terkunci, azan berfungsi di ponsel ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kilitliyken bunu duyuyorsanız ezan bu telefonda çalışıyor demektir."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিন লক থাকা অবস্থায় এটি শুনতে পেলে এই ফোনে আজান কাজ করে।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous entendez ceci écran verrouillé, l’adhan fonctionne sur ce téléphone."
          }
        }
      }
    },
