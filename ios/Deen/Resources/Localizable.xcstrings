    "core_alarm_kahf_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Surah Al-Kahf today. Tap to open it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرأ سورة الكهف اليوم. اضغط لفتحها."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج سورۂ کہف پڑھیں۔ کھولنے کے لیے تھپتھپائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bacalah Surah Al-Kahf hari ini. Ketuk untuk membukanya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün Kehf suresini okuyun. Açmak için dokunun."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ সূরা আল-কাহফ পড়ুন। খুলতে ট্যাপ করুন।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez la sourate Al-Kahf aujourd'hui. Touchez pour l'ouvrir."
          }
        }
      }
    },
