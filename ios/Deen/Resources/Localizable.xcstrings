    },
    "core_alarm_after_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The adhan was %1$lld minute ago. Prayer at its time is among the deeds Allah loves most."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The adhan was %1$lld minutes ago. Prayer at its time is among the deeds Allah loves most."
                }
              }
            }
          }
        },
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أُذِّن قبل %1$lld دقيقة، و«الصلاة على وقتها» من أحب الأعمال إلى الله."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أُذِّن قبل دقيقة واحدة، و«الصلاة على وقتها» من أحب الأعمال إلى الله."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أُذِّن قبل دقيقتين، و«الصلاة على وقتها» من أحب الأعمال إلى الله."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أُذِّن قبل %1$lld دقائق، و«الصلاة على وقتها» من أحب الأعمال إلى الله."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أُذِّن قبل %1$lld دقيقة، و«الصلاة على وقتها» من أحب الأعمال إلى الله."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "أُذِّن قبل %1$lld دقيقة، و«الصلاة على وقتها» من أحب الأعمال إلى الله."
                }
              }
            }
          }
        },
        "ur": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "اذان کو %1$lld منٹ ہو گیا۔ وقت پر نماز اللہ کے سب سے پسندیدہ اعمال میں سے ہے۔"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "اذان کو %1$lld منٹ ہو گئے۔ وقت پر نماز اللہ کے سب سے پسندیدہ اعمال میں سے ہے۔"
                }
              }
            }
          }
        },
        "id": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Azan sudah %1$lld menit yang lalu. Salat tepat waktu termasuk amal yang paling dicintai Allah."
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ezan %1$lld dakika önce okundu. Vaktinde kılınan namaz, Allah'ın en sevdiği amellerdendir."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ezan %1$lld dakika önce okundu. Vaktinde kılınan namaz, Allah'ın en sevdiği amellerdendir."
                }
              }
            }
          }
        },
        "bn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "আজান হয়েছে %1$lld মিনিট আগে। সময়মতো নামাজ আল্লাহর কাছে সবচেয়ে প্রিয় আমলগুলোর একটি।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "আজান হয়েছে %1$lld মিনিট আগে। সময়মতো নামাজ আল্লাহর কাছে সবচেয়ে প্রিয় আমলগুলোর একটি।"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "L’adhan a retenti il y a %1$lld minute. La prière à son heure fait partie des œuvres qu’Allah aime le plus."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "L’adhan a retenti il y a %1$lld minutes. La prière à son heure fait partie des œuvres qu’Allah aime le plus."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "L’adhan a retenti il y a %1$lld minutes. La prière à son heure fait partie des œuvres qu’Allah aime le plus."
                }
              }
            }
          }
        }
      }
    },
    "core_alarm_after_title": {
      "extractionState": "manual",
      "localizations": {
