    "feature_hadith_all_authentic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every hadith in this collection is authentic (sahih) by scholarly consensus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحاديث هذا الكتاب صحيحة باتفاق العلماء."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس مجموعے کی ہر حدیث علماء کے اتفاق سے صحیح ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap hadis dalam kitab ini sahih menurut kesepakatan ulama."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kitaptaki her hadis, âlimlerin ittifakıyla sahihtir."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আলেমদের ঐকমত্যে এই গ্রন্থের প্রতিটি হাদিস সহিহ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les hadiths de ce recueil sont authentiques (sahih) selon le consensus des savants."
          }
        }
      }
    },
    "feature_hadith_arabic_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full collections are in Arabic, with each hadith's number and its grading by a named scholar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتب الكاملة بالعربية، مع رقم كل حديث وحكمه عند عالم معروف."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مکمل مجموعے عربی میں ہیں، ہر حدیث کے نمبر اور کسی معروف عالم کے حکم کے ساتھ۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitab lengkap tersedia dalam bahasa Arab, dengan nomor setiap hadis dan derajatnya menurut ulama yang disebut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitapların tamamı Arapçadır; her hadisin numarası ve adı geçen bir âlimin hükmüyle birlikte."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পূর্ণ গ্রন্থগুলো আরবিতে, প্রতিটি হাদিসের নম্বর ও একজন নির্দিষ্ট আলেমের মান নির্ণয়সহ।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les recueils complets sont en arabe, avec le numéro de chaque hadith et son authentification par un savant nommé."
          }
        }
      }
    },
